# Copy to .env and adjust for your environment:
#   cp .env.example .env

# InfluxDB connection (external — hosted by puda-logger)
INFLUXDB_URL=http://bearsnas:8181
INFLUXDB_TOKEN=apiv3_puda
INFLUXDB_PUDA_DATABASE=puda
INFLUXDB_HERMES_DATABASE=hermes-logs

# ReductStore connection (external — hosted by puda-logger/reductstore)
REDUCTSTORE_URL=http://bearsnas:8383
REDUCTSTORE_TOKEN=reduct

# Grafana admin account. grafana.ini and scripts/init.sh both use these.
# Changing GRAFANA_PASS does not update an account that already exists.
GRAFANA_URL=http://127.0.0.1:3000
GRAFANA_USER=admin
GRAFANA_PASS=admin

# puda can open every dashboard. imre-mof can open only GRAFANA_IMRE_MOF_DASHBOARD.
GRAFANA_VIEWER_USER=puda
GRAFANA_VIEWER_PASSWORD=berkeleybears
GRAFANA_IMRE_MOF_USER=imre-mof
GRAFANA_IMRE_MOF_PASSWORD=
GRAFANA_IMRE_MOF_DASHBOARD=imre-mof

# Grafana plugins to install on startup (not a grafana.ini setting — read by
# the image's entrypoint script to run `grafana-cli plugins install`).
# ReductStore is unsigned (GitHub release); grafana.ini allows it.
GF_INSTALL_PLUGINS=marcusolsson-dynamictext-panel,https://github.com/reductstore/reduct-grafana/releases/download/v1.2.1/reductstore-datasource-1.2.1.zip;reductstore-datasource
