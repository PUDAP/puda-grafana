      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "puda-influxdb"
          },
          "rawQuery": true,
          "rawSql": "WITH ranked AS (SELECT time, machine_id, tube, category, point_key, value_numeric, value_int, value_bool, value_text, ROW_NUMBER() OVER (PARTITION BY machine_id, point_key ORDER BY time DESC) AS rn FROM ald_point WHERE machine_id IN (${machine_id:singlequote}) AND tube IN (${tube:singlequote}) AND category IN (${category:singlequote}) AND point_key IN (${point_key:singlequote}) AND time >= now() - INTERVAL '24 hours') SELECT time, machine_id, tube, category, point_key, value_numeric, value_int, value_bool, value_text FROM ranked WHERE rn = 1 ORDER BY time DESC LIMIT 300",
          "refId": "A",
          "format": "table"
        }
      ],
      "title": "Latest Point Values (24h, max 300)",
      "type": "table"
    },
