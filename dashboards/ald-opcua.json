          "rawSql": "SELECT time, machine_id, tube, point_key, value_text AS \"Recipe / Step\" FROM (SELECT time, machine_id, tube, point_key, COALESCE(value_text, CAST(value_int AS VARCHAR), CAST(value_bool AS VARCHAR)) AS value_text FROM ald_point WHERE machine_id IN (${machine_id:singlequote}) AND tube IN (${tube:singlequote}) AND (LOWER(point_key) LIKE '%recipe%' OR LOWER(point_key) LIKE '%step%') AND $__timeFilter(time) ORDER BY time DESC LIMIT 1000) recent ORDER BY time ASC",
