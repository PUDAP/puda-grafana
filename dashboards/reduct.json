{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "All PUDA NATS traffic logged to ReductStore (commands + telemetry).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "content": "Reads from ReductStore bucket **puda** (`commands` and `telemetry` entries). Command log columns match the machine command logs (labels only).",
        "mode": "markdown"
      },
      "pluginVersion": "13.0.1",
      "title": "",
      "transparent": true,
      "type": "text"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 2 },
      "id": 2,
      "title": "Commands",
      "type": "row"
    },
    {
      "datasource": { "type": "reductstore-datasource", "uid": "puda-reductstore" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "filterable": true,
            "inspect": false,
            "minWidth": 50
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "time" },
            "properties": [
              { "id": "displayName", "value": "Time" },
              { "id": "custom.width", "value": 180 },
              { "id": "unit", "value": "dateTimeAsLocal" }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/machine_id$/" },
            "properties": [
              { "id": "displayName", "value": "Machine" },
              { "id": "custom.width", "value": 130 }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/msg_type$/" },
            "properties": [
              { "id": "displayName", "value": "Type" },
              { "id": "custom.width", "value": 90 },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "command": { "text": "CMD", "color": "blue", "index": 0 },
                      "response": { "text": "RESP", "color": "purple", "index": 1 }
                    }
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/topic$/" },
            "properties": [
              { "id": "displayName", "value": "Queue/Immediate" },
              { "id": "custom.width", "value": 120 },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "queue": { "text": "queue", "color": "blue", "index": 0 },
                      "response.queue": { "text": "queue", "color": "blue", "index": 1 },
                      "immediate": { "text": "immediate", "color": "orange", "index": 2 },
                      "response.immediate": { "text": "immediate", "color": "orange", "index": 3 }
                    }
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/cmd_name$/" },
            "properties": [
              { "id": "displayName", "value": "Command" },
              { "id": "custom.width", "value": 180 }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/status$/" },
            "properties": [
              { "id": "displayName", "value": "Status" },
              { "id": "custom.width", "value": 90 },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "sent": { "text": "Sent", "color": "blue", "index": 0 },
                      "success": { "text": "Success", "color": "green", "index": 1 },
                      "error": { "text": "Error", "color": "red", "index": 2 }
                    }
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "basic" } }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/step_number$/" },
            "properties": [
              { "id": "displayName", "value": "Step" },
              { "id": "custom.width", "value": 60 }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/username$/" },
            "properties": [
              { "id": "displayName", "value": "User" },
              { "id": "custom.width", "value": 110 }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/run_id$/" },
            "properties": [
              { "id": "displayName", "value": "Run ID" },
              { "id": "custom.width", "value": 120 }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/completed_at$/" },
            "properties": [
              { "id": "displayName", "value": "Completed At" },
              { "id": "custom.width", "value": 200 }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/cmd_version$/" },
            "properties": [
              { "id": "displayName", "value": "Version" },
              { "id": "custom.width", "value": 90 }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/subject$/" },
            "properties": [
              { "id": "displayName", "value": "Subject" },
              { "id": "custom.width", "value": 220 }
            ]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/response$/" },
            "properties": [
              { "id": "displayName", "value": "Response" },
              { "id": "custom.width", "value": 320 },
              { "id": "description", "value": "Long values stay on one line. Hover the cell and click the inspect icon to view the full response." },
              { "id": "custom.inspect", "value": true },
              { "id": "custom.cellOptions", "value": { "type": "auto", "wrapText": false } }
            ]
          }
        ]
      },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 3 },
      "id": 3,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Time" }]
      },
      "targets": [
        {
          "bucket": "puda",
          "datasource": { "type": "reductstore-datasource", "uid": "puda-reductstore" },
          "entry": "commands",
          "options": {
            "mode": "LabelOnly",
            "when": {
              "#select_labels": [
                "machine_id",
                "topic",
                "cmd_name",
                "msg_type",
                "status",
                "username",
                "run_id",
                "step_number",
                "cmd_version",
                "subject",
                "completed_at",
                "response"
              ]
            }
          },
          "refId": "A"
        }
      ],
      "title": "Command log",
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "time", "mode": "outer" }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(time|value commands/(machine_id|topic|cmd_name|msg_type|status|username|run_id|step_number|cmd_version|subject|completed_at|response))$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "time": 0,
              "value commands/machine_id": 1,
              "value commands/msg_type": 2,
              "value commands/topic": 3,
              "value commands/cmd_name": 4,
              "value commands/status": 5,
              "value commands/step_number": 6,
              "value commands/username": 7,
              "value commands/run_id": 8,
              "value commands/completed_at": 9,
              "value commands/cmd_version": 10,
              "value commands/subject": 11,
              "value commands/response": 12
            },
            "renameByName": {}
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "id": 4,
      "title": "Telemetry",
      "type": "row"
    },
    {
      "datasource": { "type": "reductstore-datasource", "uid": "puda-reductstore" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "percent"
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/temp/i" },
            "properties": [{ "id": "unit", "value": "celsius" }]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "id": 5,
      "options": {
        "legend": {
          "calcs": ["lastNotNull"],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "bucket": "puda",
          "datasource": { "type": "reductstore-datasource", "uid": "puda-reductstore" },
          "entry": "telemetry",
          "options": {
            "mode": "LabelOnly",
            "when": {
              "$each_t": "$__interval",
              "#select_labels": ["machine_id", "cpu", "mem", "temp"]
            }
          },
          "refId": "A"
        }
      ],
      "title": "CPU / mem / temp",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": { "pattern": "^(time|telemetry/(cpu|mem|temp))$" }
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "telemetry/(.*)",
            "renamePattern": "$1"
          }
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "reductstore-datasource", "uid": "puda-reductstore" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "filterable": true,
            "inspect": false
          },
          "mappings": []
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "/machine_id$/" }, "properties": [{ "id": "displayName", "value": "Machine" }] },
          { "matcher": { "id": "byRegexp", "options": "/subject$/" }, "properties": [{ "id": "displayName", "value": "NATS subject" }] },
          { "matcher": { "id": "byRegexp", "options": "/cpu$/" }, "properties": [{ "id": "displayName", "value": "CPU (%)" }] },
          { "matcher": { "id": "byRegexp", "options": "/mem$/" }, "properties": [{ "id": "displayName", "value": "Memory (%)" }] },
          { "matcher": { "id": "byRegexp", "options": "/temp$/" }, "properties": [{ "id": "displayName", "value": "Temperature (°C)" }] },
          { "matcher": { "id": "byRegexp", "options": "/connected$/" }, "properties": [{ "id": "displayName", "value": "Connected" }] },
          { "matcher": { "id": "byRegexp", "options": "/status$/" }, "properties": [{ "id": "displayName", "value": "Status" }] }
        ]
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 30 },
      "id": 6,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": true, "fields": "", "reducer": ["count"], "show": true },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Time" }]
      },
      "targets": [
        {
          "bucket": "puda",
          "datasource": { "type": "reductstore-datasource", "uid": "puda-reductstore" },
          "entry": "telemetry",
          "options": {
            "mode": "LabelOnly",
            "when": {
              "#select_labels": [
                "machine_id",
                "subject",
                "cpu",
                "mem",
                "temp",
                "connected",
                "status"
              ]
            }
          },
          "refId": "A"
        }
      ],
      "title": "Telemetry log",
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "time", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": {
              "time": "Time",
              "value telemetry/machine_id": "Machine",
              "value telemetry/subject": "NATS subject",
              "value telemetry/cpu": "CPU (%)",
              "value telemetry/mem": "Memory (%)",
              "value telemetry/temp": "Temperature (°C)",
              "value telemetry/connected": "Connected",
              "value telemetry/status": "Status",
              "value telemetry/telemetry/machine_id": "Machine",
              "value telemetry/telemetry/subject": "NATS subject",
              "value telemetry/telemetry/cpu": "CPU (%)",
              "value telemetry/telemetry/mem": "Memory (%)",
              "value telemetry/telemetry/temp": "Temperature (°C)",
              "value telemetry/telemetry/connected": "Connected",
              "value telemetry/telemetry/status": "Status",
              "telemetry/machine_id": "machine_id",
              "telemetry/subject": "subject",
              "telemetry/cpu": "cpu",
              "telemetry/mem": "mem",
              "telemetry/temp": "temp",
              "telemetry/connected": "connected",
              "telemetry/status": "status"
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["puda", "reductstore"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "Asia/Singapore",
  "title": "Reduct",
  "uid": "reduct",
  "version": 1,
  "weekStart": ""
}
