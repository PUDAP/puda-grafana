      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "puda-influxdb"
          },
          "rawSql": "SELECT time, machine_id, msg_type, CASE WHEN topic = 'queue' AND msg_type = 'command' THEN 'queue' WHEN topic = 'response.queue' AND msg_type = 'response' THEN 'queue' WHEN topic = 'immediate' AND msg_type = 'command' THEN 'immediate' WHEN topic = 'response.immediate' AND msg_type = 'response' THEN 'immediate' ELSE COALESCE(topic, '') || ' ' || COALESCE(msg_type, '') END AS queue_type, COALESCE(cmd_name, '') AS command, status, COALESCE(CAST(step_number AS VARCHAR), '') AS step, username, COALESCE(run_id, '') AS run_id, COALESCE(CAST(completed_at AS VARCHAR), '') AS completed_at, COALESCE(cmd_version, '') AS version, COALESCE(host, '') AS host, COALESCE(subject, '') AS subject, COALESCE(CAST(response_message AS VARCHAR), CAST(response_code AS VARCHAR), '') AS response FROM commands WHERE $__timeFilter(time) AND machine_id IN ('first', 'biologic', 'opentrons', 'elephant', 'joule-heating', 'pipqubot_mof', 'dobot-m1pro', 'capper', 'bioshake', 'pescador-pipqubot', 'light', 'stage', 'zaber', 'keithley-2450', 'keithley-707b', 'keysight-b2902b') ORDER BY time DESC LIMIT 500",
          "format": "table",
          "refId": "A",
          "rawQuery": true
        }
      ],
