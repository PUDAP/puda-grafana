        "helpers": "",
        "styles": ".puda-map{font-family:Inter,Helvetica,Arial,sans-serif;color:#d8d9da;padding:4px 8px 8px}\n.puda-map *{box-sizing:border-box}\n.puda-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}\n.puda-col{background:#181b1f;border:1px solid rgba(204,204,220,.28);border-radius:4px;padding:12px;min-width:0}\na.puda-site,a.puda-site:link,a.puda-site:visited,a.puda-site:hover,a.puda-site:active{display:block;text-decoration:none!important;color:#fff!important;background:#1a56c9!important;border-radius:4px;padding:14px 12px;font-weight:800;font-size:22px;letter-spacing:.12em;margin:0 0 12px;text-align:center;line-height:1.2}\na.puda-site:hover{background:#3274d9!important;color:#fff!important}\na.puda-name,a.puda-name:link,a.puda-name:visited{color:#fff!important;text-decoration:none!important}\n.puda-card{border:1px solid rgba(204,204,220,.12);border-radius:3px;padding:10px;margin:0 0 8px}\n.puda-card:last-child{margin:0}\n.puda-card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}\n.puda-name{display:block;text-decoration:none;font-size:15px;font-weight:650;color:#fff;margin:0;min-width:0}\n.puda-name:hover{color:#3274d9}\n.puda-status{flex:0 0 auto;border-radius:999px;padding:2px 8px;font-size:11px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;line-height:1.4}\n.puda-card.status-online{border-color:#73BF69;background:rgba(115,191,105,.14)}\n.puda-card.status-online .puda-status{background:#73BF69;color:#111}\n.puda-card.status-offline{border-color:#F2495C;background:rgba(242,73,92,.12)}\n.puda-card.status-offline .puda-status{background:#F2495C;color:#fff}\n.puda-desc{font-size:12px;color:#9b9b9f;margin:4px 0 6px;line-height:1.35}\n.puda-machines{display:flex;flex-wrap:wrap;gap:5px;margin:0;padding-bottom:6px}\n.puda-machines span{display:inline-block;background:rgba(204,204,220,.08);border:1px solid rgba(204,204,220,.28);border-radius:999px;padding:2px 8px;font-size:11px;font-weight:600;color:#d8d9da;line-height:1.3}\n.puda-links{display:flex;flex-wrap:wrap;gap:6px}\n.puda-links a{display:inline-block;text-decoration:none;color:#d8d9da;border:1px solid rgba(204,204,220,.28);border-radius:3px;padding:3px 8px;font-size:11px;font-weight:600}\n.puda-links a:hover{border-color:#3274d9;color:#fff}\n.puda-links a.live{border-color:#3274d9;color:#fff}\n@media (max-width: 1100px){.puda-grid{grid-template-columns:1fr}}\n",
        "afterRender": ""
      },
      "pluginVersion": "6.3.0",
      "title": "",
      "type": "marcusolsson-dynamictext-panel",
      "datasource": {
        "type": "influxdb",
        "uid": "puda-influxdb"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "puda-influxdb"
          },
          "rawSql": "SELECT\n  now() AS time,\n  MAX(CASE WHEN setup = 'first' THEN status END) AS first,\n  MAX(CASE WHEN setup = 'opentrons' THEN status END) AS opentrons,\n  MAX(CASE WHEN setup = 'elephant' THEN status END) AS elephant,\n  MAX(CASE WHEN setup = 'joule' THEN status END) AS joule,\n  MAX(CASE WHEN setup = 'mof' THEN status END) AS mof,\n  MAX(CASE WHEN setup = 'pescador' THEN status END) AS pescador,\n  MAX(CASE WHEN setup = 'vipsa' THEN status END) AS vipsa\nFROM (\n  SELECT 'first' AS setup, CASE WHEN COUNT(*) > 0 THEN 'online' ELSE 'offline' END AS status\n  FROM telemetry WHERE machine_id = 'first' AND time >= now() - INTERVAL '2 minutes'\n  UNION ALL\n  SELECT 'opentrons', CASE WHEN COUNT(*) > 0 THEN 'online' ELSE 'offline' END\n  FROM telemetry WHERE machine_id = 'opentrons' AND time >= now() - INTERVAL '2 minutes'\n  UNION ALL\n  SELECT 'elephant', CASE WHEN COUNT(*) > 0 THEN 'online' ELSE 'offline' END\n  FROM telemetry WHERE machine_id = 'elephant' AND time >= now() - INTERVAL '2 minutes'\n  UNION ALL\n  SELECT 'joule', CASE WHEN COUNT(*) > 0 THEN 'online' ELSE 'offline' END\n  FROM telemetry WHERE machine_id = 'joule-heating' AND time >= now() - INTERVAL '2 minutes'\n  UNION ALL\n  SELECT 'mof', CASE WHEN COUNT(*) > 0 THEN 'online' ELSE 'offline' END\n  FROM telemetry WHERE machine_id = 'bioshake' AND time >= now() - INTERVAL '2 minutes'\n  UNION ALL\n  SELECT 'pescador', CASE WHEN COUNT(*) > 0 THEN 'online' ELSE 'offline' END\n  FROM telemetry WHERE machine_id = 'pescador-pipqubot' AND time >= now() - INTERVAL '2 minutes'\n  UNION ALL\n  SELECT 'vipsa', CASE WHEN COUNT(*) > 0 THEN 'online' ELSE 'offline' END\n  FROM telemetry WHERE machine_id IN ('light', 'stage', 'zaber', 'keithley-2450', 'keithley-707b', 'keysight-b2902b') AND time >= now() - INTERVAL '2 minutes'\n)",
          "format": "table",
          "refId": "A",
          "rawQuery": true
        }
      ]
    },
