      "options": {
        "content": "<style>\n.puda-map{font-family:Inter,Helvetica,Arial,sans-serif;color:#d8d9da;padding:4px 8px 8px}\n.puda-map *{box-sizing:border-box}\n.puda-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}\n.puda-col{background:#181b1f;border:1px solid rgba(204,204,220,.28);border-radius:4px;padding:12px;min-width:0}\n.puda-site{display:block;text-decoration:none!important;color:#fff!important;background:#1a56c9!important;border-radius:4px;padding:14px 12px;font-weight:800;font-size:22px;letter-spacing:.12em;margin:0 0 12px;text-align:center;line-height:1.2}\n.puda-card{border:1px solid rgba(204,204,220,.12);border-radius:3px;padding:10px;margin:0 0 8px}\n.puda-card:last-child{margin:0}\n.puda-name{display:block;font-size:15px;font-weight:650;color:#fff;margin:0 0 2px}\n.puda-subtitle{font-size:12px;color:#9b9b9f;margin:0 0 6px;line-height:1.35}\n.puda-machines{display:flex;flex-wrap:wrap;gap:5px;margin:0}\n.puda-machines span{display:inline-block;background:rgba(204,204,220,.08);border:1px solid rgba(204,204,220,.28);border-radius:999px;padding:2px 8px;font-size:11px;font-weight:600;color:#d8d9da;line-height:1.3}\n@media (max-width: 1100px){.puda-grid{grid-template-columns:1fr}}\n</style>\n<div class=\"puda-map\">\n  <div class=\"puda-grid\">\n    <div class=\"puda-col\">\n      <div class=\"puda-site\">SNU</div>\n      <div class=\"puda-card\">\n        <div class=\"puda-name\">Rainbow Robotics</div>\n        <div class=\"puda-subtitle\">PLC controlled system for batteries</div>\n        <div class=\"puda-machines\"><span>Robotic arm (Electrolyte/Cell handling)</span><span>Syringe pump (Electrolyte formulation)</span><span>Injection Machine (Injecting electrolyte and vacuum wetting)</span><span>Sealing machine (Cell Sealing)</span></div>\n      </div>\n    </div>\n    <div class=\"puda-col\">\n      <div class=\"puda-site\">MIT</div>\n      <div class=\"puda-card\">\n        <div class=\"puda-name\">DiSCO</div>\n        <div class=\"puda-subtitle\">Discovery, Synthesis, Characterization, and Optimization</div>\n        <div class=\"puda-machines\"><span>robotic arm (5-DOF)</span><span>photoconductivity probe (4-DOF)</span></div>\n      </div>\n    </div>\n    <div class=\"puda-col\">\n      <div class=\"puda-site\">U of T (Accelerated Consortium)</div>\n      <div class=\"puda-card\">\n        <div class=\"puda-subtitle\">Oxygen Evolution Reaction experiments</div>\n        <div class=\"puda-machines\"><span>opentrons flex</span><span>biologic</span></div>\n      </div>\n    </div>\n  </div>\n</div>",
