      "options": {
        "content": "<div class=\"puda-map\">\n  <div class=\"puda-grid\">\n    <div class=\"puda-col\">\n      <a class=\"puda-site\" href=\"/d/bears/bears\">BEARS</a>\n      <div class=\"puda-card status-{{first}}\">\n        <div class=\"puda-card-head\">\n          <a class=\"puda-name\" href=\"/d/bears-first/bears-first\">First</a>\n          <span class=\"puda-status\">{{first}}</span>\n        </div>\n        <div class=\"puda-desc\">electrochemistry</div>\n        <div class=\"puda-machines\"><span>first</span><span>biologic</span></div>\n        <div class=\"puda-links\">\n          <a href=\"/d/bears-first/bears-first\">Dashboard</a> <a class=\"live\" href=\"https://cam-first.puda.co/livestream\" target=\"_blank\" rel=\"noopener noreferrer\">Livestream</a>\n        </div>\n      </div>\n      <div class=\"puda-card status-{{opentrons}}\">\n        <div class=\"puda-card-head\">\n          <a class=\"puda-name\" href=\"/d/bears-opentrons/bears-opentrons\">Opentrons</a>\n          <span class=\"puda-status\">{{opentrons}}</span>\n        </div>\n        <div class=\"puda-desc\">color mixing and viscosity testing</div>\n        <div class=\"puda-machines\"><span>opentrons</span></div>\n        <div class=\"puda-links\">\n          <a href=\"/d/bears-opentrons/bears-opentrons\">Dashboard</a> <a class=\"live\" href=\"https://cam-opentron.puda.co/livestream\" target=\"_blank\" rel=\"noopener noreferrer\">Livestream</a>\n        </div>\n      </div>\n      <div class=\"puda-card status-{{elephant}}\">\n        <div class=\"puda-card-head\">\n          <a class=\"puda-name\" href=\"/d/bears-elephant/bears-elephant\">Elephant</a>\n          <span class=\"puda-status\">{{elephant}}</span>\n        </div>\n        <div class=\"puda-desc\">robotic arm</div>\n        <div class=\"puda-machines\"><span>elephant</span></div>\n        <div class=\"puda-links\">\n          <a href=\"/d/bears-elephant/bears-elephant\">Dashboard</a>\n        </div>\n      </div>\n      <div class=\"puda-card status-{{joule}}\">\n        <div class=\"puda-card-head\">\n          <a class=\"puda-name\" href=\"/d/bears-joule_heater/bears-joule_heater\">Joule Heater</a>\n          <span class=\"puda-status\">{{joule}}</span>\n        </div>\n        <div class=\"puda-desc\">joule synthesis</div>\n        <div class=\"puda-machines\"><span>joule heater</span></div>\n        <div class=\"puda-links\">\n          <a href=\"/d/bears-joule_heater/bears-joule_heater\">Dashboard</a> <a class=\"live\" href=\"https://cam-joule-heater.puda.co/cam\" target=\"_blank\" rel=\"noopener noreferrer\">Livestream</a>\n        </div>\n      </div>\n    </div>\n    <div class=\"puda-col\">\n      <a class=\"puda-site\" href=\"/d/imre/imre\">IMRE</a>\n      <div class=\"puda-card status-{{mof}}\">\n        <div class=\"puda-card-head\">\n          <a class=\"puda-name\" href=\"/d/imre-mof/imre-mof\">IMRE MOF</a>\n          <span class=\"puda-status\">{{mof}}</span>\n        </div>\n        <div class=\"puda-desc\">MOF synthesis</div>\n        <div class=\"puda-machines\"><span>pipqubot</span><span>dobot</span><span>capper</span><span>bioshake</span></div>\n        <div class=\"puda-links\">\n          <a href=\"/d/imre-mof/imre-mof\">Dashboard</a> <a class=\"live\" href=\"https://cam-imre-mof.puda.co/hikvision-ptz-left/\" target=\"_blank\" rel=\"noopener noreferrer\">Left camera</a> <a class=\"live\" href=\"https://cam-imre-mof.puda.co/hikvision-ptz-right/\" target=\"_blank\" rel=\"noopener noreferrer\">Right camera</a>\n        </div>\n      </div>\n      <div class=\"puda-card status-{{pescador}}\">\n        <div class=\"puda-card-head\">\n          <a class=\"puda-name\" href=\"/d/imre-pescador/imre-pescador\">Pescador</a>\n          <span class=\"puda-status\">{{pescador}}</span>\n        </div>\n        <div class=\"puda-desc\">polymer electrolyte materials acceleration platform, performing formulation, synthesis and characterization of photocurable polymer electrolyte samples</div>\n        <div class=\"puda-machines\"><span>pescador pipqubot</span></div>\n        <div class=\"puda-links\">\n          <a href=\"/d/imre-pescador/imre-pescador\">Dashboard</a> <a class=\"live\" href=\"https://cam-pescador.puda.co/livestream\" target=\"_blank\" rel=\"noopener noreferrer\">Livestream</a>\n        </div>\n      </div>\n    </div>\n    <div class=\"puda-col\">\n      <a class=\"puda-site\" href=\"/d/ntu/ntu\">NTU</a>\n      <div class=\"puda-card status-{{vipsa}}\">\n        <div class=\"puda-card-head\">\n          <a class=\"puda-name\" href=\"/d/ntu-vipsa/ntu-vipsa\">VIPSA</a>\n          <span class=\"puda-status\">{{vipsa}}</span>\n        </div>\n        <div class=\"puda-desc\">memresistor</div>\n        <div class=\"puda-machines\"><span>light</span><span>stage</span><span>zaber</span><span>keithley 2450</span><span>keithley 707B</span><span>keysight B2902B</span></div>\n        <div class=\"puda-links\">\n          <a href=\"/d/ntu-vipsa/ntu-vipsa\">Dashboard</a> <a class=\"live\" href=\"https://cam-vipsa.puda.co/camera1/\" target=\"_blank\" rel=\"noopener noreferrer\">Camera 1</a> <a class=\"live\" href=\"https://cam-vipsa.puda.co/camera2/\" target=\"_blank\" rel=\"noopener noreferrer\">Camera 2</a> <a href=\"http://vipsa-ubuntu:8765/\" target=\"_blank\" rel=\"noopener noreferrer\">Manual jog</a>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n",
